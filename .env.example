# CERES — variables de entorno (copiar a .env; NUNCA versionar .env con secretos).

# --- Obligatorio para arrancar la API ---------------------------------------
# PostgreSQL (docker compose de desarrollo publica 127.0.0.1:5440).
DATABASE_URL=postgresql+psycopg://ceres:ceres_dev@127.0.0.1:5440/ceres

# Origen público desde el que el navegador llama a la API (mismo origen que la web).
APP_ORIGIN=http://localhost:3000
# Solo en desarrollo por HTTP: desactiva el atributo Secure de las cookies. En producción: false.
DEV_INSECURE_COOKIES=true
SESSION_TTL_HOURS=72

# --- Opcional: asistente IA (sin ellas la interfaz muestra «IA no conectada») --
# Se leen solo en el backend. No usar prefijos NEXT_PUBLIC_.
# Proveedor principal: Google Gemini (se acepta GEMINI_MODE como alias de GEMINI_MODEL).
GEMINI_API_KEY=
GEMINI_MODEL=
# 0 = respuesta rápida sin razonamiento extendido (el motor ya calculó); vacío = valor del modelo.
GEMINI_THINKING_BUDGET=0
# Alternativa: OpenAI Responses (solo se usa si Gemini no está configurado).
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=40

# --- Opcional: datos y caché -------------------------------------------------
# Ruta relativa dentro de data/ de la copia real de NASA POWER (descargada con `ceres.cli fetch-nasa`).
NASA_SNAPSHOT_FILE=nasa/power_daily_majes_2015_2025.json
# Descargar distritos de otros departamentos desde SERFOR la primera vez que se piden (se cachean en data/regions).
REGIONS_LIVE_FETCH=true

# --- Solo para el servidor Next.js en desarrollo ------------------------------
# Destino del rewrite /api/v1 → FastAPI (no se expone al navegador).
API_ORIGIN=http://127.0.0.1:8000
